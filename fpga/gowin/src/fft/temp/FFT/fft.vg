`pragma protect end_protected
module FFT_Top (
  idx,
  xk_re,
  xk_im,
  sod,
  ipd,
  eod,
  busy,
  soud,
  opd,
  eoud,
  xn_re,
  xn_im,
  start,
  clk,
  rst
)
;
output [7:0] idx;
output [15:0] xk_re;
output [15:0] xk_im;
output sod;
output ipd;
output eod;
output busy;
output soud;
output opd;
output eoud;
input [15:0] xn_re;
input [15:0] xn_im;
input start;
input clk;
input rst;
wire VCC;
wire GND;
  \~fft_top.FFT_Top  fft_top_inst (
    .start(start),
    .clk(clk),
    .rst(rst),
    .xn_re(xn_re[15:0]),
    .xn_im(xn_im[15:0]),
    .sod(sod),
    .soud(soud),
    .eoud(eoud),
    .busy(busy),
    .ipd(ipd),
    .eod(eod),
    .opd(opd),
    .idx(idx[7:0]),
    .xk_im(xk_im[15:0]),
    .xk_re(xk_re[15:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* FFT_Top */
